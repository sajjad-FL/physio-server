MONGODB_URI=mongodb://localhost:27017/syco

# SPA origin for /api/seo/physio-sitemap.xml <loc> entries (no trailing slash). Must match the live marketing site.
# Production: https://physiokhom.com — Local: http://localhost:5173
PUBLIC_CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=change_me
# Fallback gross amount (₹) when admin pricing settings are unset in PlatformSettings (Admin → Pricing & rates).
DEFAULT_BOOKING_AMOUNT_RUPEES=500
# Fallback platform commission (₹ per session) when unset in admin pricing settings.
PLATFORM_COMMISSION_PER_SESSION=100
# Legacy fallback: percent of default session price if PLATFORM_COMMISSION_PER_SESSION is unset.
PLATFORM_FEE_PERCENT=20
# Razorpay Standard Checkout — use the same mode for both (test Key ID rzp_test_* with test Key Secret from that key).
# Avoid trailing spaces when pasting; both values are trimmed on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Fallback order amount in paise if a booking has no amount (optional).
RAZORPAY_AMOUNT_PAISE=50000
# When true: signup/forgot-password return OTP in JSON + console (local dev without WhatsApp).
# Local dev only: when true, skip WhatsApp and return the OTP in the API response.
DEBUG_OTP=false
# Fast2SMS WhatsApp Cloud API (https://www.fast2sms.com/dev/whatsapp)
# Authorization header = API key from Fast2SMS Dev API section
FAST2SMS_API_KEY=
FAST2SMS_PHONE_NUMBER_ID=1274348429090137
FAST2SMS_MESSAGE_ID_OTP=26913
FAST2SMS_MESSAGE_ID_PAYMENT=26922
FAST2SMS_MESSAGE_ID_APPOINTMENT=26916
FAST2SMS_MESSAGE_ID_FEEDBACK=26926
FAST2SMS_MESSAGE_ID_PHYSIO_UPCOMING=26927
# 3:00 AM Asia/Kolkata — WhatsApp each physio their visits for the day
CRON_PHYSIO_DAILY_REMINDERS=true
# CRON_PHYSIO_DAILY_REMINDERS_EXPR=0 3 * * *

# Mobile push — server relays via Expo (https://exp.host). No firebase-admin on the server.
# Production: set true when mobile apps register Expo push tokens.
# Do NOT set FIREBASE_* env vars; Firebase Admin is not used by this codebase.
EXPO_PUSH_ENABLED=true
