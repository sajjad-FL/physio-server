# Nginx snippet for PhysiOkhom API (physio-server behind PM2)
#
# Physio registration uploads multipart FormData with up to ~15 files (500 KB each).
# Default nginx client_max_body_size is 1m — causes HTTP 413 before Node sees the request.
#
# Apply on production:
#   1. Copy or merge into your site config, e.g. /etc/nginx/sites-available/physiokhom
#   2. sudo nginx -t && sudo systemctl reload nginx
#
# Adjust proxy_pass port to match PM2 (default PORT=5000).

server {
    listen 443 ssl http2;
    server_name api.physiokhom.com;   # replace with your API host

    # Required for physio registration + document uploads (~8MB max theoretical)
    client_max_body_size 50m;

    ssl_certificate     /etc/letsencrypt/live/api.physiokhom.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.physiokhom.com/privkey.pem;

    location /api/ {
        client_max_body_size 50m;

        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Optional: stream large uploads instead of buffering entirely in nginx
        proxy_request_buffering off;

        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }

    # If auth routes are mounted at /auth without /api prefix on the same host:
    location /auth/ {
        client_max_body_size 50m;

        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }
}
